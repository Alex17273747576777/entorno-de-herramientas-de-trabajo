CREATE TABLE feed_categories(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    sort INTEGER NOT NULL,
    lang TEXT NOT NULL DEFAULT 'all',
    explore INTEGER AS Boolean NOT NULL DEFAULT 0
);

INSERT OR IGNORE INTO feed_categories(_id, name, sort) VALUES (1, 'Global', 0);

-- Sin cláusula REFERENCES a propósito: SQLite rechaza "Cannot add a REFERENCES column with non-NULL
-- default value", así que una columna con FK y DEFAULT 1 no se puede añadir por ALTER. La columna se
-- añade sin FK y el CREATE TABLE de feed_saved_search.sq tampoco la declara, para que el esquema de una
-- instalación limpia y el de una actualizada sean idénticos (que es lo que SQLDelight verifica).
ALTER TABLE feed_saved_search ADD COLUMN category INTEGER NOT NULL DEFAULT 1;
ALTER TABLE feed_saved_search ADD COLUMN feed_order INTEGER NOT NULL DEFAULT 0;
ALTER TABLE feed_saved_search ADD COLUMN search_type INTEGER NOT NULL DEFAULT 1;

CREATE INDEX feed_saved_search_category_index ON feed_saved_search(category);
