# origen-ruta preparar-entorno-android.sh: scripts/preparar-entorno-android.sh
# origen-ruta bajar-referencias.sh: scripts/bajar-referencias.sh
# origen-ruta auditar-referencias.py: tools/auditar-referencias.py
